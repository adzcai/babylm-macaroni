+# The 17 Universal Dependencies UPOS tags.  Newer `datasets` releases no longer run the
+# UD loading script (`trust_remote_code` is ignored) and fall back to the Hub's parquet
+# auto-conversion, where `upos` arrives as a list of tag STRINGS instead of the script's
+# Sequence(ClassLabel).  Everything downstream (the label-set consistency check in
+# build_pos_mixture, and finetune_token_classification's use of the ids as labels)
+# needs the ClassLabel form, so we restore it here.  Token accuracy is invariant to the
+# id order; alphabetical keeps the mapping deterministic and documented.
+UPOS_TAGS = ("ADJ", "ADP", "ADV", "AUX", "CCONJ", "DET", "INTJ", "NOUN", "NUM",
+             "PART", "PRON", "PROPN", "PUNCT", "SCONJ", "SYM", "VERB", "X")
+
+
+def _ensure_upos_classlabel(raw: DatasetDict, column: str = "upos") -> DatasetDict:
+    """Cast a string-typed `upos` column back to Sequence(ClassLabel(UPOS_TAGS))."""
+    first = next(iter(raw.values()))
+    inner = getattr(first.features[column], "feature", None)
+    if isinstance(inner, ClassLabel):
+        return raw
+    return raw.cast_column(column, Sequence(ClassLabel(names=list(UPOS_TAGS))))
+
+
 def build_pos_split(
     config: str,
     max_sentences: int | None = None,
